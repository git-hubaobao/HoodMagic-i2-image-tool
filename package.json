{
  "name": "hoodmagic-i2-image-tool",
  "version": "1.0.0",
  "private": true,
  "description": "HoodMagic小魔帽 - i2 生图工具",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter image-tool dev",
    "build": "pnpm --filter image-tool build",
    "lint": "oxlint --fix && eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix && pnpm format:check",
    "test": "pnpm --filter @hoodmagic/storage test && pnpm --filter @hoodmagic/task-core test && pnpm --filter @hoodmagic/provider-adapters test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "package": "pnpm --filter image-tool dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@eslint/js": "^9.22.0",
    "@eslint-react/eslint-plugin": "^1.36.1",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^1.15.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "oxlint": "^1.56.0",
    "vitest": "^3.2.4"
  }
}
